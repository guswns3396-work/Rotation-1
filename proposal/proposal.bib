	pages = {17--35},
	file = {PDF:C\:\\Users\\yhyunjoo\\Zotero\\storage\\HLSZNGIT\\Shingleton and Palfai - 2016 - Technology-delivered adaptations of motivational interviewing for health-related behaviors A system.pdf:application/pdf},
